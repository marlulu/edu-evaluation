# ============================================================
#  教育评估系统 — 环境变量配置
#  用法: cp .env.example .env 然后修改下面的值
# ============================================================

# ---------- 应用端口 ----------
APP_PORT=80

# ---------- MySQL ----------
MYSQL_DATABASE=edu_evaluation
MYSQL_USER=edu
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# ---------- RabbitMQ ----------
RABBITMQ_USER=edu
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ---------- MinIO ----------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_BUCKET=coursework-submissions

# ---------- AI 模型配置 ----------
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-your-api-key-here
MODEL_PROVIDER_DRIVER=openai-compatible
MODEL_TIMEOUT_SECONDS=180

# 各模块模型（按需填写）
TEXT_PROVIDER_NAME=
TEXT_MODEL_NAME=
VISION_PROVIDER_NAME=
VISION_MODEL_NAME=
MULTIMODAL_PROVIDER_NAME=
MULTIMODAL_MODEL_NAME=
ASR_PROVIDER_NAME=
ASR_MODEL_NAME=
OCR_PROVIDER_NAME=
OCR_MODEL_NAME=
