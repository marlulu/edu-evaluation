# ============================================================
#  教育评估系统 — 生产环境配置
#  用法: cp .env.production .env && vim .env
# ============================================================

# ---------- 应用域名 ----------
DOMAIN=your-domain.com

# ---------- MySQL ----------
MYSQL_DATABASE=edu_evaluation
MYSQL_USER=edu
MYSQL_PASSWORD=CHANGE_ME_mysql_strong_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_strong_password

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ---------- MinIO ----------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password
MINIO_BUCKET=coursework-submissions

# ---------- AI 模型（必填）----------
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-CHANGE_ME_your_api_key
MODEL_PROVIDER_DRIVER=openai-compatible
MODEL_TIMEOUT_SECONDS=300

# ---------- 模型名称 ----------
TEXT_PROVIDER_NAME=openai
TEXT_MODEL_NAME=gpt-4o
VISION_PROVIDER_NAME=openai
VISION_MODEL_NAME=gpt-4o
MULTIMODAL_PROVIDER_NAME=openai
MULTIMODAL_MODEL_NAME=gpt-4o
ASR_PROVIDER_NAME=openai
ASR_MODEL_NAME=whisper-1
OCR_PROVIDER_NAME=
OCR_MODEL_NAME=
