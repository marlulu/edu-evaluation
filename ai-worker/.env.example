# AI Worker 环境配置示例
# 复制此文件为 .env 并填入你的配置

AI_WORKER_ENV=local
AI_WORKER_SERVICE_NAME=edu-evaluation-ai-worker

# ========== 模型配置（必填） ==========
MODEL_PROVIDER_DRIVER=openai-compatible

# OpenAI 兼容 API 地址
# - OpenAI 官方: https://api.openai.com/v1
# - 其他兼容服务: 填写对应地址
MODEL_API_BASE_URL=https://api.openai.com/v1

# API Key（sk-... 开头）
MODEL_API_KEY=sk-your-api-key-here

# 请求超时时间（秒）
# AI 评价任务可能需要较长时间，建议设置为 120-300 秒
MODEL_TIMEOUT_SECONDS=180

# ========== 文本模型（用于作业评分、内容分析） ==========
TEXT_PROVIDER_NAME=openai-compatible
TEXT_MODEL_NAME=gpt-4o

# ========== 视觉模型（用于图像理解、OCR） ==========
VISION_PROVIDER_NAME=openai-compatible
VISION_MODEL_NAME=gpt-4o

# ========== 语音模型（用于音频转录 ASR） ==========
SPEECH_PROVIDER_NAME=openai-compatible
AUDIO_MODEL_NAME=whisper-1

# ========== 多模态模型（用于视频/图文综合分析） ==========
MULTIMODAL_PROVIDER_NAME=openai-compatible
MULTIMODAL_MODEL_NAME=gpt-4o

# ========== OCR 模型（用于文字识别） ==========
OCR_PROVIDER_NAME=openai-compatible
OCR_MODEL_NAME=gpt-4o

# ========== ASR 模型（用于语音识别） ==========
ASR_PROVIDER_NAME=openai-compatible
ASR_MODEL_NAME=whisper-1

# ========== 可选配置 ==========
# 解析任务回调地址
# PARSE_TASK_CALLBACK_URL=http://localhost:8080/api/callback

# 解析产物存储路径
# PARSE_ARTIFACT_BASE_PATH=data/parsing-artifacts

# 压缩包解压路径
# ARCHIVE_EXTRACT_BASE_PATH=data/archive-work
